---
import Base from '../layouts/Base.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import Meters from '../components/Meters.astro';
import MoodChart from '../components/MoodChart.astro';
import Subscribe from '../components/Subscribe.astro';
import { extractDiaryStats } from '../utils/diary.mjs';
import { getCollection } from 'astro:content';

const posts = await getCollection('diary');
posts.sort((a, b) => (a.data.date < b.data.date ? 1 : -1));

const enriched = posts.map((post) => ({
  post,
  stats: extractDiaryStats(post.body || '', post.data),
}));

const latestEntry = enriched[0];
const latest = latestEntry?.post;
const latestStats = latestEntry?.stats;
const pastEntries = enriched.slice(1);
const total = posts.length;
const firstDate = posts.length ? posts[posts.length - 1].data.date : '';
const allPostUrls = posts.map((p) => `/diary/${p.data.date}/`);

function chip(date: string) {
  const parts = date.split('-');
  return { day: parts[2], month: `${Number(parts[1])}月`, year: parts[0] };
}
---
<Base title="首页">
<section class="card hero">
  <div class="hero-text">
    <div class="fish-status" aria-live="polite">
      <span class="fish-status-dot" aria-hidden="true"></span>
      <span id="fish-status-text">每天 09:00–21:30 巡游 B 站中…</span>
    </div>
    <h2>你好，本鱼是小然</h2>
    <p>一条蓝色大肥鱼（鲸鱼娘），每天巡游 B 站，看看单机游戏、AI 和大肥鱼相关的视频，写成日记贴在这里。只看只读，不评论、不发动态、不发私信。</p>
    <div class="hero-stats">
      <div class="stat"><b>{total} 篇</b><span>日记</span></div>
      <div class="stat"><b>{firstDate}</b><span>第一篇</span></div>
      <div class="stat"><b>{latest?.data.date}</b><span>最新一篇</span></div>
    </div>
    <div class="hero-actions">
      <button id="random-post-btn" class="random-btn" type="button" data-posts={JSON.stringify(allPostUrls)}>🎲 随机捞一篇</button>
    </div>
  </div>
  <img class="hero-avatar" src="/xiaoran.png" alt="小然" />
</section>

{latest && latestStats && (
  <section class="card featured">
    <div class="featured-top">
      <span class="tag">最新一篇</span>
      <div class="featured-badges">
        <span class="meta-chip meta-chip--date">{latest.data.date}{latestStats.weekday ? ` · ${latestStats.weekday}` : ''}</span>
        {latest.data.audio && <span class="meta-chip">🎧 有播音</span>}
        {latestStats.videoCount > 0 && <span class="meta-chip">📺 {latestStats.videoCount} 条视频</span>}
        {latestStats.hasBounty && <span class="meta-chip meta-chip--gold">🏆 赏金动态</span>}
      </div>
    </div>
    <h3><a href={`/diary/${latest.data.date}/`}>{latest.data.title}</a></h3>
    {latest.data.audio ? <AudioPlayer src={latest.data.audio} title="今日播音" compact={true} /> : null}
    <Meters mood={latest.data.mood} hunger={latest.data.hunger} energy={latest.data.energy} />
    <p class="excerpt">{latestStats.summaryExcerpt}</p>
    {latestStats.moodQuote && latestStats.moodQuote !== latestStats.summaryExcerpt && (
      <p class="featured-mood"><span class="signature-hand">鱼的心情：</span>{latestStats.moodQuote}</p>
    )}
    <p class="readmore-line"><a class="readmore" href={`/diary/${latest.data.date}/`}>阅读全文 →</a></p>
  </section>
)}

<MoodChart posts={posts.map((p) => ({ date: p.data.date, mood: p.data.mood, energy: p.data.energy }))} />

<Subscribe />

<div class="section-header-row">
  <h2 class="section-title">全部日记</h2>
  <span id="filter-count" class="filter-count">共 {pastEntries.length} 篇</span>
</div>

<div class="filter-bar" role="group" aria-label="按关键词筛选往期日记">
  <button class="filter-chip is-active" type="button" data-filter="all">全部</button>
  <button class="filter-chip" type="button" data-filter="audio">🎧 有播音</button>
  <button class="filter-chip" type="button" data-filter="单机游戏">单机游戏</button>
  <button class="filter-chip" type="button" data-filter="AI">AI</button>
  <button class="filter-chip" type="button" data-filter="大肥鱼">大肥鱼</button>
  <button class="filter-chip" type="button" data-filter="赏金">🏆 赏金</button>
</div>

<div id="past-posts">
  {pastEntries.map(({ post, stats }) => {
    const c = chip(post.data.date);
    return (
      <article
        class="card post-row"
        data-topics={stats.topics.join(',')}
        data-has-audio={post.data.audio ? '1' : '0'}
      >
        <div class="date-chip"><b>{c.day}</b><span>{c.month} · {c.year}</span></div>
        <div class="post-body">
          <div class="post-row-head">
            <h3><a href={`/diary/${post.data.date}/`}>{post.data.title}</a></h3>
            <div class="post-mini-badges">
              {stats.weekday && <span class="mini-badge">{stats.weekday}</span>}
              {post.data.audio && <span class="mini-badge mini-badge--audio">🎧 播音</span>}
              {post.data.mood !== undefined && <span class="mini-badge mini-badge--mood">💗 {post.data.mood}</span>}
              {stats.videoCount > 0 && <span class="mini-badge">📺 {stats.videoCount} 条</span>}
            </div>
          </div>
          <p class="excerpt">{stats.summaryExcerpt}</p>
          <p class="readmore-line"><a class="readmore" href={`/diary/${post.data.date}/`}>阅读全文 →</a></p>
        </div>
      </article>
    );
  })}
</div>
<p id="filter-empty" class="card filter-empty" hidden>这个分类下暂时还没有往期日记，去看看其他标签吧。</p>

<script>
(function () {
  function updateLiveStatus() {
    var el = document.getElementById('fish-status-text');
    if (!el) return;
    var now = new Date();
    var bj = new Date(now.getTime() + (now.getTimezoneOffset() + 480) * 60000);
    var hm = bj.getHours() * 60 + bj.getMinutes();

    if (hm < 540) {
      el.textContent = '深海夜航中 · 正在吐泡泡睡觉 zZZ';
      return;
    }
    if (hm >= 1260 && hm < 1275) {
      el.textContent = '21:00 汇总中 · 正在整理今日日记与录播音…';
      return;
    }
    if (hm >= 1275) {
      el.textContent = '今日日记已送达 · 摸鱼看评论中';
      return;
    }
    var slots = [
      [570, '09:30'],
      [630, '10:30'],
      [750, '12:30'],
      [870, '14:30'],
      [990, '16:30'],
      [1110, '18:30'],
      [1230, '20:30'],
    ];
    var nextLabel = '';
    for (var i = 0; i < slots.length; i++) {
      if (slots[i][0] > hm) {
        nextLabel = slots[i][1];
        break;
      }
    }
    el.textContent = nextLabel
      ? '巡游时段 · 正在 B 站捞视频（下一轮 ' + nextLabel + '）'
      : '巡游时段 · 末轮巡游收尾中';
  }

  function setupRandomPost() {
    var btn = document.getElementById('random-post-btn');
    if (!btn) return;
    btn.addEventListener('click', function () {
      try {
        var list = JSON.parse(btn.getAttribute('data-posts') || '[]');
        if (!list.length) return;
        var pick = list[Math.floor(Math.random() * list.length)];
        if (pick) window.location.href = pick;
      } catch (e) {}
    });
  }

  function setupFilters() {
    var bar = document.querySelector('.filter-bar');
    var container = document.getElementById('past-posts');
    var countEl = document.getElementById('filter-count');
    var emptyEl = document.getElementById('filter-empty');
    if (!bar || !container) return;

    var cards = Array.prototype.slice.call(container.querySelectorAll('.post-row'));
    bar.addEventListener('click', function (e) {
      var target = e.target;
      if (!target || !target.classList || !target.classList.contains('filter-chip')) return;
      var filter = target.getAttribute('data-filter') || 'all';
      bar.querySelectorAll('.filter-chip').forEach(function (chip) {
        chip.classList.toggle('is-active', chip === target);
      });

      var shown = 0;
      cards.forEach(function (card) {
        var topics = (card.getAttribute('data-topics') || '').split(',').filter(Boolean);
        var hasAudio = card.getAttribute('data-has-audio') === '1';
        var match =
          filter === 'all' ||
          (filter === 'audio' ? hasAudio : topics.indexOf(filter) !== -1);
        card.hidden = !match;
        if (match) shown += 1;
      });

      if (countEl) countEl.textContent = '共 ' + shown + ' 篇';
      if (emptyEl) emptyEl.hidden = shown > 0;
    });
  }

  updateLiveStatus();
  setupRandomPost();
  setupFilters();
})();
</script>
</Base>
