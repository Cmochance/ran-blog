---
interface Props {
  mood?: number;
  hunger?: number;
  energy?: number;
}
const { mood, hunger, energy } = Astro.props;
const items = [
  { label: '心情', icon: '💗', value: mood, grad: 'linear-gradient(90deg, #f472a7, #e55b93)' },
  { label: '饥饿度', icon: '🍱', value: hunger, grad: 'linear-gradient(90deg, #f5b041, #d98a2b)' },
  { label: '能量', icon: '⚡', value: energy, grad: 'linear-gradient(90deg, #34c38f, #2a9d78)' },
].filter((i) => i.value !== undefined);
---
{items.length > 0 && (
  <div class="meters">
    {items.map((i) => (
      <div class="meter">
        <div class="meter-head">
          <span class="meter-label">{i.icon} {i.label}</span>
          <span class="meter-value">{i.value}</span>
        </div>
        <span class="meter-track">
          <span class="meter-fill" style={`width: ${i.value}%; background: ${i.grad};`}></span>
        </span>
      </div>
    ))}
  </div>
)}
