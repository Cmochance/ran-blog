---
import Base from './Base.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'diary'>;
  prev?: { date: string; title: string } | null;
  next?: { date: string; title: string } | null;
}

const { post, prev, next } = Astro.props;
const { date, title, mood, hunger, energy } = post.data;
---
<Base title={title}>
<article class="card">
<p class="meta">{date}</p>
<h2>{title}</h2>
<p>
{mood !== undefined && <span class="badge">心情 {mood}</span>}
{hunger !== undefined && <span class="badge">饥饿度 {hunger}</span>}
{energy !== undefined && <span class="badge">能量 {energy}</span>}
</p>
<slot />
</article>
<nav class="prevnext">
<span>{prev ? <a href={`/diary/${prev.date}/`}>← {prev.title}</a> : ''}</span>
<span>{next ? <a href={`/diary/${next.date}/`}>{next.title} →</a> : ''}</span>
</nav>
</Base>
