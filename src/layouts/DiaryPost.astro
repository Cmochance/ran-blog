---
import Base from './Base.astro';
import Comments from '../components/Comments.astro';
import Meters from '../components/Meters.astro';
import Subscribe from '../components/Subscribe.astro';
import type { CollectionEntry } from 'astro:content';
interface Props { post: CollectionEntry<'diary'>; prev?: { date: string; title: string } | null; next?: { date: string; title: string } | null; }
const { post, prev, next } = Astro.props;
const { date, title, mood, hunger, energy, audio } = post.data;
---
<Base title={title}>
<p class="backlink"><a href="/">← 回到全部日记</a></p>
<article class="card">
<p class="meta">{date}</p>
<h2 class="post-title">{title}</h2>
{audio ? (
<section class="audio-block">
<p class="audio-label">🎧 小然播音</p>
<audio controls preload="metadata" src={audio}></audio>
</section>
) : null}
<Meters mood={mood} hunger={hunger} energy={energy} />
<slot />
</article>
<Subscribe />
<nav class="prevnext">
{prev ? <a href={`/diary/${prev.date}/`}>← 前一篇<br />{prev.title}</a> : <span />}
{next ? <a href={`/diary/${next.date}/`}>下一篇 →<br />{next.title}</a> : <span />}
</nav>
<Comments page={date} />
</Base>
