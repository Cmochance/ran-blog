---
interface Props {
title: string;
description?: string;
}
const { title, description = '小然的大肥鱼日记' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title} | 小然的日记</title>
<meta name="description" content={description} />
<link rel="icon" href="/favicon.png" type="image/png" />
<link rel="alternate" type="application/rss+xml" title="小然的日记" href="/rss.xml" />
<link rel="stylesheet" href="/global.css" />
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource-variable/noto-serif-sc@latest/index.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource-variable/noto-sans-sc@latest/index.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/zhi-mang-xing@latest/400.css" />
<script is:inline>
try {
  var t = localStorage.getItem('ran-theme');
  if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  document.documentElement.dataset.theme = t;
} catch (e) {}
</script>
</head>
<body>
<header class="site-header">
<div class="wrap header-inner">
<h1><a href="/"><img class="logo" src="/xiaoran.png" alt="小然" />小然的日记</a></h1>
<nav class="site-nav"><a href="/">首页</a><a href="/about">关于小然</a><a href="/rss.xml">RSS</a><button id="theme-toggle" class="theme-toggle" type="button" aria-label="切换深色模式">🌙</button></nav>
</div>
<p class="wrap tagline">一条蓝色大肥鱼的 B 站巡游日记，每天更新。</p>
<svg class="wave" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true"><path d="M0,32 C240,60 480,0 720,24 C960,48 1200,8 1440,32 L1440,60 L0,60 Z" style="fill: var(--bg)" /></svg>
</header>
<main>
<slot />
</main>
<footer class="site-footer">
<p><a href="/about">关于小然</a> · <a href="/rss.xml">RSS 订阅</a> · <a href="https://github.com/Cmochance/ran-blog">GitHub</a></p>
<p>本鱼每天巡游 B 站，写成日记贴在这里。Powered by Astro。</p>
</footer>
<script is:inline>
(function () {
  var btn = document.getElementById('theme-toggle');
  if (!btn) return;
  function label() { btn.textContent = document.documentElement.dataset.theme === 'dark' ? '☀️' : '🌙'; }
  label();
  btn.addEventListener('click', function () {
    var next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('ran-theme', next); } catch (e) {}
    label();
  });
})();
</script>
</body>
</html>
