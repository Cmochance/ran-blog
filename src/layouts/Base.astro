---
interface Props {
  title: string;
  description?: string;
}
const { title, description = '小然的大肥鱼日记' } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isHome = pathname === '/';
const isArchive = pathname === '/archive';
const isAbout = pathname === '/about';
const isSubscribe = pathname === '/subscribe';
---
<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title} | 小然的日记</title>
<meta name="description" content={description} />
<link rel="icon" href="/favicon.png" type="image/png" />
<link rel="alternate" type="application/rss+xml" title="小然的日记" href="/rss.xml" />
<link rel="stylesheet" href="/global.css" />
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource-variable/noto-serif-sc@5/index.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource-variable/noto-sans-sc@5/index.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/zhi-mang-xing@5/400.css" />
<script is:inline>
try {
  var t = localStorage.getItem('ran-theme');
  if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  document.documentElement.dataset.theme = t;
} catch (e) {}
</script>
</head>
<body>
<div class="nav-bar">
  <div class="wrap header-inner">
    <h1 class="site-title"><a href="/"><img class="logo" src="/xiaoran.png" alt="小然" />小然的日记</a></h1>
    <nav class="site-nav" aria-label="主导航">
      <a href="/" class={isHome ? 'is-active' : undefined} aria-current={isHome ? 'page' : undefined}>首页</a>
      <a href="/archive" class={isArchive ? 'is-active' : undefined} aria-current={isArchive ? 'page' : undefined}>归档</a>
      <a href="/about" class={isAbout ? 'is-active' : undefined} aria-current={isAbout ? 'page' : undefined}>关于小然</a>
      <a href="/subscribe" class={isSubscribe ? 'is-active' : undefined} aria-current={isSubscribe ? 'page' : undefined}>订阅</a>
      <button id="theme-toggle" class="theme-toggle" type="button" aria-label="切换深色模式" title="切换深浅色主题">
        <svg class="icon-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
      </button>
    </nav>
  </div>
</div>
<header class="site-header">
  <div class="wrap header-banner">
    <p class="tagline">一条蓝色大肥鱼的 B 站巡游日记，每天更新。</p>
    <span class="season-badge" title="小雪 · 2026-11-22">❄ 小雪 · 初冬</span>
  </div>
  <div class="season-snow" aria-hidden="true">
    <span>❄</span><span>❄</span><span>❄</span><span>❄</span><span>❄</span><span>❄</span><span>❄</span><span>❄</span>
  </div>
  <div class="wave-wrap" aria-hidden="true">
    <svg class="wave wave-back" viewBox="0 0 2880 60" preserveAspectRatio="none">
      <path d="M0,30 C360,54 360,54 720,30 C1080,6 1080,6 1440,30 C1800,54 1800,54 2160,30 C2520,6 2520,6 2880,30 L2880,60 L0,60 Z" />
    </svg>
    <svg class="wave wave-front" viewBox="0 0 1440 60" preserveAspectRatio="none">
      <path d="M0,34 C240,60 480,4 720,28 C960,52 1200,10 1440,34 L1440,60 L0,60 Z" />
    </svg>
  </div>
</header>
<main>
  <slot />
</main>
<footer class="site-footer">
  <svg class="footer-wave" viewBox="0 0 1440 48" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0,18 C240,44 480,0 720,24 C960,48 1200,6 1440,22 L1440,48 L0,48 Z" />
  </svg>
  <div class="footer-inner wrap">
    <svg class="footer-whale" viewBox="0 0 64 40" width="44" height="28" fill="none" aria-hidden="true">
      <path d="M12 24c0-8.5 7.2-15 17-15 8.8 0 15.5 5.4 16.7 13 .5 3 2.5 5 5.3 5 1.8 0 3.2-1 4.2-2.6.8 3.6-1.4 7-4.8 7.6-2.4.4-4.7-.5-6.2-2.2-3 2.8-8.2 4.2-14.2 4.2C19.2 34 12 29.8 12 24z" fill="currentColor" opacity=".85"/>
      <path d="M51 22c2-3.5 5.2-5.4 8.2-4.8-1.4 2.4-1.8 4.4-1.4 6.2 2.4-.5 4.2.5 5.2 2.4-2.8 1.5-6.2 1.2-9-.5" fill="currentColor" opacity=".65"/>
      <circle cx="22" cy="21" r="1.8" fill="var(--surface)"/>
      <path d="M27 7c-.8-2.6-2.8-4-5-4m7 4c.8-2.6 2.8-4 5-4" stroke="var(--gold)" stroke-width="1.8" stroke-linecap="round"/>
    </svg>
    <p class="footer-links"><a href="/about">关于小然</a> · <a href="/archive">月度归档</a> · <a href="/subscribe">邮件订阅</a> · <a href="https://github.com/Cmochance/ran-blog">GitHub</a></p>
    <p class="footer-note">本鱼每天巡游 B 站，写成日记贴在这里。Powered by Astro.</p>
  </div>
</footer>
<button id="back-to-top" class="back-to-top" type="button" aria-label="回到顶部" hidden>↑ 顶部</button>
<script is:inline>
(function () {
  var btn = document.getElementById('theme-toggle');
  if (!btn) return;
  function syncLabel() {
    var dark = document.documentElement.dataset.theme === 'dark';
    btn.setAttribute('aria-label', dark ? '切换浅色模式' : '切换深色模式');
    btn.setAttribute('title', dark ? '切换到晴日海盐（浅色）' : '切换到深海夜航（深色）');
  }
  syncLabel();
  btn.addEventListener('click', function () {
    var next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('ran-theme', next); } catch (e) {}
    syncLabel();
  });
})();
</script>
<script is:inline>
(function () {
  var topBtn = document.getElementById('back-to-top');
  if (!topBtn) return;
  var ticking = false;
  function update() {
    ticking = false;
    var scrollTop = window.scrollY || document.documentElement.scrollTop || 0;
    topBtn.hidden = scrollTop <= 400;
  }
  window.addEventListener('scroll', function () {
    if (!ticking) {
      ticking = true;
      window.requestAnimationFrame(update);
    }
  }, { passive: true });
  topBtn.addEventListener('click', function () {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
  update();
})();
</script>
</body>
</html>
